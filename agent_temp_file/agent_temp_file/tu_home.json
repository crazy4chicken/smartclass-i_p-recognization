!----></header><!----><!----><div class=\"VPContent is-home\" id=\"VPContent\" data-v-ed049380=\"\" data-v-3f00b3d7=\"\"><div class=\"VPHome\" data-v-3f00b3d7=\"\" data-v-0987e04b=\"\"><!--[--><!--]--><div class=\"VPHero VPHomeHero\" data-v-0987e04b=\"\" data-v-1ccf43dd=\"\"><div class=\"container\" data-v-1ccf43dd=\"\"><div class=\"main\" data-v-1ccf43dd=\"\"><!--[--><!--]--><!--[--><h1 class=\"heading\" data-v-1ccf43dd=\"\"><span class=\"name clip\" data-v-1ccf43dd=\"\">Teamusers</span><span class=\"text\" data-v-1ccf43dd=\"\">Standalone IAM microservice</span></h1><p class=\"tagline\" data-v-1ccf43dd=\"\">Identity, authentication, and authorization for the service fleet.</p><!--]--><!--[--><!--]--><div class=\"actions\" data-v-1ccf43dd=\"\"><!--[--><div class=\"action\" data-v-1ccf43dd=\"\"><a class=\"VPButton medium brand\" href=\"/nsc-teamusers/guide/getting-started\" data-v-1ccf43dd=\"\" data-v-0f88888c=\"\">Get Started</a></div><div class=\"action\" data-v-1ccf43dd=\"\"><a class=\"VPButton medium alt\" href=\"/nsc-teamusers/api/overview\" data-v-1ccf43dd=\"\" data-v-0f88888c=\"\">API Reference</a></div><!--]--></div><!--[--><!--]--></div><!----></div></div><!--[--><!--]--><!--[--><!--]--><div class=\"VPFeatures VPHomeFeatures\" data-v-0987e04b=\"\" data-v-630c1782=\"\"><div class=\"container\" data-v-630c1782=\"\"><div class=\"items\" data-v-630c1782=\"\"><!--[--><div class=\"grid-6 item\" data-v-630c1782=\"\"><div class=\"VPLink no-icon VPFeature\" data-v-630c1782=\"\" data-v-63cac1a9=\"\"><!--[--><article class=\"box\" data-v-63cac1a9=\"\"><!----><h2 class=\"title\" data-v-63cac1a9=\"\">OIDC-style EdDSA JWT authentication</h2><p class=\"details\" data-v-63cac1a9=\"\">Issue short-lived access tokens with refresh rotation, JWKS discovery, and permission-version checks.</p><!----></article><!--]--></div></div><div class=\"grid-6 item\" data-v-630c1782=\"\"><div class=\"VPLink no-icon VPFeature\" data-v-630c1782=\"\" data-v-63cac1a9=\"\"><!--[--><article class=\"box\" data-v-63cac1a9=\"\"><!----><h2 class=\"title\" data-v-63cac1a9=\"\">RBAC plus ABAC authorization</h2><p class=\"details\" data-v-63cac1a9=\"\">Resolve direct, group, and team-baseline role bindings with conditional resource, action, and scope permissions.</p><!----></article><!--]--></div></div><div class=\"grid-6 item\" data-v-630c1782=\"\"><div class=\"VPLink no-icon VPFeature\" data-v-630c1782=\"\" data-v-63cac1a9=\"\"><!--[--><article class=\"box\" data-v-63cac1a9=\"\"><!----><h2 class=\"title\" data-v-63cac1a9=\"\">Team-scoped delegated administration</h2><p class=\"details\" data-v-63cac1a9=\"\">Delegate team operations while keeping platform-only resources and escalation boundaries explicit.</p><!----></article><!--]--></div></div><div class=\"grid-6 item\" data-v-630c1782=\"\"><div class=\"VPLink no-icon VPFeature\" data-v-630c1782=\"\" data-v-63cac1a9=\"\"><!--[--><article class=\"box\" data-v-63cac1a9=\"\"><!----><h2 class=\"title\" data-v-63cac1a9=\"\">Complete account lifecycle</h2><p class=\"details\" data-v-63cac1a9=\"\">Cover registration, verification, invitation, approval, password recovery, and profile erasure workflows.</p><!----></article><!--]--></div></div><div class=\"grid-6 item\" data-v-630c1782=\"\"><div class=\"VPLink no-icon VPFeature\" data-v-630c1782=\"\" data-v-63cac1a9=\"\"><!--[--><article class=\"box\" data-v-63cac1a9=\"\"><!----><h2 class=\"title\" data-v-63cac1a9=\"\">TOTP and passkey MFA</h2><p class=\"details\" data-v-63cac1a9=\"\">Protect users with RFC 6238 TOTP, one-time backup codes, and WebAuthn passkey ceremonies.</p><!----></article><!--]--></div></div><div class=\"grid-6 item\" data-v-630c1782=\"\"><div class=\"VPLink no-icon VPFeature\" data-v-630c1782=\"\" data-v-63cac1a9=\"\"><!--[--><article class=\"box\" data-v-63cac1a9=\"\"><!----><h2 class=\"title\" data-v-63cac1a9=\"\">Nekostick child-process deployment</h2><p class=\"details\" data-v-63cac1a9=\"\">Run a static Linux binary under supervised listener leases, health checks, graceful drain, and key sharing.</p><!----></article><!--]--></div></div><!--]--></div></div></div><!--[--><!--]--><div class=\"vp-doc container\" style=\"\" data-v-0987e04b=\"\" data-v-235b88af=\"\"><!--[--><div style=\"position:relative;\" data-v-0987e04b=\"\"><div></div></div><!--]--></div></div></div><!----><!--[--><!--]--></div></div>\n    <script>window.__VP_HASH_MAP__=JSON.parse(\"{\\\"api_overview.md\\\":\\\"DWii_Gzu\\\",\\\"api_reference_audit.md\\\":\\\"D3lLmgKE\\\",\\\"api_reference_authentication.md\\\":\\\"n8U0qKyl\\\",\\\"api_reference_authorization.md\\\":\\\"CTvtCV6q\\\",\\\"api_reference_bindings.md\\\":\\\"uju0C-lD\\\",\\\"api_reference_groups.md\\\":\\\"Ck5BWKOq\\\",\\\"api_reference_health.md\\\":\\\"CiS_ahAU\\\",\\\"api_reference_impersonation.md\\\":\\\"BSpjMmVy\\\",\\\"api_reference_invitations.md\\\":\\\"Boei7E22\\\",\\\"api_reference_keys.md\\\":\\\"CYymxlmB\\\",\\\"api_reference_permissions.md\\\":\\\"H-UiqeRA\\\",\\\"api_reference_policies.md\\\":\\\"BFjQoRc1\\\",\\\"api_reference_roles.md\\\":\\\"Bld7dMgd\\\",\\\"api_reference_scim.md\\\":\\\"BgcacYHD\\\",\\\"api_reference_self-service.md\\\":\\\"B88oDatV\\\",\\\"api_reference_sessions.md\\\":\\\"BYb5Xf74\\\",\\\"api_reference_teams.md\\\":\\\"DTe2O4MW\\\",\\\"api_reference_users.md\\\":\\\"Bq3quiQS\\\",\\\"guide_api-docs.md\\\":\\\"B9sGsemP\\\",\\\"guide_getting-started.md\\\":\\\"DTDvzP3Z\\\",\\\"guide_nekostick.md\\\":\\\"B33_5-uY\\\",\\\"guide_operations.md\\\":\\\"DDSxzW5_\\\",\\\"guide_pagination.md\\\":\\\"DOeh__oz\\\",\\\"guide_permission-keys.md\\\":\\\"ltwUxAPt\\\",\\\"guide_permissions.md\\\":\\\"fnvPEfMa\\\",\\\"guide_sdks.md\\\":\\\"Dr7dpJgh\\\",\\\"guide_security.md\\\":\\\"CFXzVQSF\\\",\\\"guide_subjects.md\\\":\\\"CeIz5BXA\\\",\\\"index.md\\\":\\\"Nx9HR7Dt\\\"}\");window.__VP_SITE_DATA__=JSON.parse(\"{\\\"lang\\\":\\\"en-US\\\",\\\"dir\\\":\\\"ltr\\\",\\\"title\\\":\\\"Teamusers\\\",\\\"description\\\":\\\"Standalone IAM microservice\\\",\\\"base\\\":\\\