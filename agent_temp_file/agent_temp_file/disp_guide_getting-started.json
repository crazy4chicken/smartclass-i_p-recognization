    "html": "<html lang=\"en-US\" dir=\"ltr\"><head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n    <title>Getting Started | SmartClass Dispatch Hub</title>\n    <meta name=\"description\" content=\"Timetable-driven recording scheduler and control plane for SmartClass\">\n    <meta name=\"generator\" content=\"VitePress v1.6.4\">\n    <link rel=\"preload stylesheet\" href=\"/smartclass-dispatchub/assets/style.BiE_8ryU.css\" as=\"style\">\n    <link rel=\"preload stylesheet\" href=\"/smartclass-dispatchub/vp-icons.css\" as=\"style\">\n    \n    <script type=\"module\" src=\"/smartclass-dispatchub/assets/app.DPLQh6zu.js\"></script>\n    <link rel=\"preload\" href=\"/smartclass-dispatchub/assets/inter-roman-latin.Di8DUHzh.woff2\" as=\"font\" type=\"font/woff2\" crossorigin=\"\">\n    <link rel=\"modulepreload\" href=\"/smartclass-dispatchub/assets/chunks/theme.21M3aUz1.js\">\n    <link rel=\"modulepreload\" href=\"/smartclass-dispatchub/assets/chunks/framework.vCELxyjF.js\">\n    <link rel=\"modulepreload\" href=\"/smartclass-dispatchub/assets/guide_getting-started.md.wz7grhI0.lean.js\">\n    <script id=\"check-dark-mode\">(()=>{const e=localStorage.getItem(\"vitepress-theme-appearance\")||\"auto\",a=window.matchMedia(\"(prefers-color-scheme: dark)\").matches;(!e||e===\"auto\"?a:e===\"dark\")&&document.documentElement.classList.add(\"dark\")})();</script>\n    <script id=\"check-mac-os\">document.documentElement.classList.toggle(\"mac\",/Mac|iPhone|iPod|iPad/i.test(navigator.platform));</script>\n  <link rel=\"prefetch\" href=\"/smartclass-dispatchub/assets/index.md.DSrjbafV.js\"><link rel=\"prefetch\" href=\"/smartclass-dispatchub/assets/api_overview.md.DAAwgvcA.js\"><link rel=\"prefetch\" href=\"/smartclass-dispatchub/assets/guide_deploy.md.CUQCsgKU.js\"><link rel=\"prefetch\" href=\"/smartclass-dispatchub/assets/guide_permissions.md.BAY9nC24.js\"><link rel=\"prefetch\" href=\"/smartclass-dispatchub/assets/guide_api-usage.md.wObd_Icc.js\"><link rel=\"prefetch\" href=\"/smartclass-dispatchub/assets/guide_operations.md.CZMdaLa4.js\"></head>\n  <body>\n    <div id=\"app\"><div class=\"Layout\" data-v-51608ad5=\"\"><!--[--><!--]--><!--[--><span tabindex=\"-1\" data-v-bed8e9ee=\"\"></span><a href=\"#VPContent\" class=\"VPSkipLink visually-hidden\" data-v-bed8e9ee=\"\">Skip to content</a><!--]--><!----><header class=\"VPNav\" data-v-51608ad5=\"\" data-v-a755e119=\"\"><div class=\"VPNavBar has-sidebar top\" data-v-a755e119=\"\" data-v-c248beec=\"\"><div class=\"wrapper\" data-v-c248beec=\"\"><div class=\"container\" data-v-c248beec=\"\"><div class=\"title\" data-v-c248beec=\"\"><div class=\"VPNavBarTitle has-sidebar\" data-v-c248beec=\"\" data-v-e409c7c9=\"\"><a class=\"title\" href=\"/smartclass-dispatchub/\" data-v-e409c7c9=\"\"><!--[--><!--]--><!----><span data-v-e409c7c9=\"\">SmartClass Dispatch Hub</span><!--[--><!--]--></a></div></div><div class=\"content\" data-v-c248beec=\"\"><div class=\"content-body\" data-v-c248beec=\"\"><!--[--><!--]--><div class=\"VPNavBarSearch search\" data-v-c248beec=\"\"><!--[--><!----><div id=\"local-search\"><button type=\"button\" class=\"DocSearch DocSearch-Button\" aria-label=\"Search\"><span class=\"DocSearch-Button-Container\"><span class=\"vp-icon DocSearch-Search-Icon\"></span><span class=\"DocSearch-Button-Placeholder\">Search</span></span><span class=\"DocSearch-Button-Keys\"><kbd class=\"DocSearch-Button-Key\"></kbd><kbd class=\"DocSearch-Button-Key\">K</kbd></span></button></div><!--]--></div><nav aria-labelledby=\"main-nav-aria-label\" class=\"VPNavBarMenu menu\" data-v-c248beec=\"\" data-v-fa9e5ef7=\"\"><span id=\"main-nav-aria-label\" class=\"visually-hidden\" data-v-fa9e5ef7=\"\"> Main Navigation </span><!--[--><!--[--><a class=\"VPLink link VPNavBarMenuLink active\" href=\"/smartclass-dispatchub/guide/getting-started\" tabindex=\"0\" data-v-fa9e5ef7=\"\" data-v-5a422097=\"\"><!--[--><span data-v-5a422097=\"\">Guide</spa